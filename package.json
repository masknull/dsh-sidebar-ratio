{
  "name": "dsh-sidebar-ratio",
  "version": "0.2.1",
  "description": "DSH web plugin: 让侧边栏按窗口「比例」打开（左侧栏 14% 起，右侧栏可选），拖原生把手/快捷键直接调，比例存 localStorage；并让子代理会话继承父会话的右侧栏标签。不改 DSH 源码。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masknull/dsh-sidebar-ratio.git"
  },
  "bugs": {
    "url": "https://github.com/masknull/dsh-sidebar-ratio/issues"
  },
  "homepage": "https://github.com/masknull/dsh-sidebar-ratio#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/dom.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "layout",
    "ratio"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1"
  }
}
